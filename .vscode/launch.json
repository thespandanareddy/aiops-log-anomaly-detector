{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit: Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "dashboard/app.py",
                "--server.port",
                "8501"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "FastAPI: REST Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "api.app:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Python: Run Demo Evaluation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_demo.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
